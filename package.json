{
  "name": "circuit-json-to-altium",
  "version": "0.0.1",
  "description": "Convert Circuit JSON schematic and PCB content into native Altium Designer project documents",
  "module": "lib/index.ts",
  "types": "lib/index.ts",
  "type": "module",
  "files": ["lib"],
  "trustedDependencies": ["altiumts"],
  "scripts": {
    "check": "bun run format:check && bun run typecheck && bun run verify-open-source-boards && bun test",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "verify-open-source-boards": "bun run scripts/verify-open-source-boards.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tscircuit/circuit-json-to-altium.git"
  },
  "keywords": [
    "circuit-json",
    "altium",
    "pcb",
    "schematic",
    "eda",
    "tscircuit"
  ],
  "license": "MIT",
  "dependencies": {
    "altiumts": "github:tscircuit/altiumts#1e36852b1e80bc503293cb18081a8b0bc0b489de",
    "circuit-json": "^0.0.469",
    "jszip": "^3.10.1",
    "schematic-symbols": "^0.0.239",
    "transformation-matrix": "^3.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/bun": "latest",
    "bun-match-svg": "^0.0.16",
    "circuit-to-svg": "^0.0.403",
    "tscircuit": "^0.0.2352",
    "typescript": "^5.9.3"
  }
}
